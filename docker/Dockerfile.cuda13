# Build CTranslate2 wheel for CUDA 13.1 (Triton 26.01-py3 compatibility)
#
# Usage:
#   DOCKER_BUILDKIT=1 docker build \
#     -f docker/Dockerfile.cuda13 \
#     --target output \
#     --output type=local,dest=./dist-cuda13 \
#     .

FROM nvidia/cuda:13.1.1-devel-ubuntu24.04 AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-dev \
        python3-pip \
        build-essential \
        cmake \
        git \
        libcudnn9-dev-cuda-13 \
        curl \
        gfortran \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Build OpenBLAS (static) for CPU SGEMM backend
ENV OPENBLAS_VERSION=0.3.21
RUN curl -L -O https://github.com/xianyi/OpenBLAS/releases/download/v${OPENBLAS_VERSION}/OpenBLAS-${OPENBLAS_VERSION}.tar.gz && \
    tar xf *.tar.gz && rm *.tar.gz && \
    cd OpenBLAS-* && \
    make NO_SHARED=1 BUILD_SINGLE=1 NO_LAPACK=1 ONLY_CBLAS=1 USE_OPENMP=1 NUM_THREADS=32 NUM_PARALLEL=8 -j$(nproc) && \
    make install NO_SHARED=1 && \
    cd .. && rm -rf OpenBLAS-*

WORKDIR /root

COPY third_party third_party
COPY cli cli
COPY include include
COPY src src
COPY cmake cmake
COPY python python
COPY CMakeLists.txt .
COPY README.md .

ENV CTRANSLATE2_ROOT=/opt/ctranslate2

RUN mkdir build_tmp && \
    cd build_tmp && \
    cmake -DCMAKE_INSTALL_PREFIX=${CTRANSLATE2_ROOT} \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_CXX_FLAGS="-msse4.1" \
          -DBUILD_CLI=OFF \
          -DWITH_MKL=OFF \
          -DWITH_DNNL=OFF \
          -DCMAKE_PREFIX_PATH="/opt/OpenBLAS" \
          -DWITH_OPENBLAS=ON \
          -DOPENMP_RUNTIME=COMP \
          -DWITH_CUDA=ON \
          -DWITH_CUDNN=ON \
          -DCUDA_DYNAMIC_LOADING=ON \
          -DCUDA_NVCC_FLAGS="-Xfatbin=-compress-all" \
          -DCUDA_ARCH_LIST="7.5;8.0;8.6;9.0" \
          -DWITH_TENSOR_PARALLEL=OFF \
          .. && \
    VERBOSE=1 make -j$(nproc) install

RUN python3 -m pip --no-cache-dir install --break-system-packages \
        auditwheel patchelf

RUN cd python && \
    python3 -m pip --no-cache-dir install --break-system-packages \
        -r install_requirements.txt && \
    CTRANSLATE2_ROOT=${CTRANSLATE2_ROOT} \
    python3 setup.py bdist_wheel --dist-dir /tmp/raw-wheel

# Bundle libctranslate2.so into the wheel, excluding CUDA/cuDNN runtime libs
RUN LD_LIBRARY_PATH=${CTRANSLATE2_ROOT}/lib:${LD_LIBRARY_PATH} \
    auditwheel repair /tmp/raw-wheel/*.whl \
        --plat manylinux_2_39_x86_64 \
        --wheel-dir /output \
        --exclude libcudnn.so.9 \
        --exclude libcudart.so.13 \
        --exclude libcuda.so.1 \
        --exclude libnvinfer.so.10

FROM scratch AS output
COPY --from=builder /output/*.whl /
